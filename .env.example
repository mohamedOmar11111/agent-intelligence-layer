# Agent Intelligence Layer - Environment Configuration
# Works with ANY LLM via LiteLLM (100+ providers)
# Uncomment ONE provider block below

# ============================================
# OLLAMA (Local, Free, Private) — RECOMMENDED
# ============================================
AIL_MODEL_PROVIDER=ollama
AIL_MODEL_NAME=qwen2.5:7b
AIL_MODEL_BASE_URL=http://localhost:11434/v1
AIL_MODEL_API_KEY=ollama
# Other local models: llama3.1:8b, phi3:mini, mistral:7b, codellama:7b

# ============================================
# OPENAI (Cloud, Pay-per-use)
# ============================================
# AIL_MODEL_PROVIDER=openai
# AIL_MODEL_NAME=gpt-4o-mini          # Cheap, fast
# AIL_MODEL_NAME=gpt-4o               # Best quality
# AIL_MODEL_NAME=gpt-4o-2024-08-06    # Structured outputs
# AIL_MODEL_API_KEY=sk-your-openai-key
# AIL_MODEL_BASE_URL=https://api.openai.com/v1  # Optional (default)

# ============================================
# ANTHROPIC CLAUDE (Cloud, Pay-per-use)
# ============================================
# AIL_MODEL_PROVIDER=anthropic
# AIL_MODEL_NAME=claude-3-5-sonnet-20241022  # Best for coding/reasoning
# AIL_MODEL_NAME=claude-3-5-haiku-20241022   # Fast, cheap
# AIL_MODEL_NAME=claude-3-opus-20240222      # Most capable
# AIL_MODEL_API_KEY=sk-ant-your-key

# ============================================
# GOOGLE GEMINI (Cloud, Pay-per-use)
# ============================================
# AIL_MODEL_PROVIDER=gemini
# AIL_MODEL_NAME=gemini-1.5-pro          # Best quality
# AIL_MODEL_NAME=gemini-1.5-flash        # Fast, cheap, 1M context
# AIL_MODEL_NAME=gemini-1.5-flash-8b     # Cheapest
# AIL_MODEL_API_KEY=your-google-ai-key
# AIL_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ============================================
# AZURE OPENAI (Enterprise)
# ============================================
# AIL_MODEL_PROVIDER=azure
# AIL_MODEL_NAME=gpt-4o                  # Your deployment name
# AIL_MODEL_API_KEY=your-azure-key
# AIL_MODEL_BASE_URL=https://your-resource.openai.azure.com
# AIL_MODEL_API_VERSION=2024-08-01-preview

# ============================================
# AWS BEDROCK (Enterprise)
# ============================================
# AIL_MODEL_PROVIDER=bedrock
# AIL_MODEL_NAME=anthropic.claude-3-5-sonnet-20241022-v2:0
# AIL_MODEL_NAME=anthropic.claude-3-haiku-20240307-v1:0
# AIL_MODEL_NAME=meta.llama3-1-70b-instruct-v1:0
# AWS credentials via ~/.aws/credentials or env vars

# ============================================
# VERTEX AI (Google Cloud)
# ============================================
# AIL_MODEL_PROVIDER=vertex_ai
# AIL_MODEL_NAME=gemini-1.5-pro
# AIL_MODEL_PROJECT=your-gcp-project
# AIL_MODEL_LOCATION=us-central1
# GCP credentials via gcloud auth

# ============================================
# LITELLM PROXY / CUSTOM OPENAI-COMPATIBLE
# ============================================
# AIL_MODEL_PROVIDER=litellm
# AIL_MODEL_NAME=your-model-name
# AIL_MODEL_BASE_URL=http://localhost:4000/v1  # LiteLLM proxy
# AIL_MODEL_API_KEY=your-proxy-key

# ============================================
# LM STUDIO / VLLM / LOCALAI (Local OpenAI-compatible)
# ============================================
# AIL_MODEL_PROVIDER=openai
# AIL_MODEL_NAME=local-model
# AIL_MODEL_BASE_URL=http://localhost:1234/v1   # LM Studio
# AIL_MODEL_BASE_URL=http://localhost:8000/v1   # vLLM
# AIL_MODEL_BASE_URL=http://localhost:8080/v1   # LocalAI
# AIL_MODEL_API_KEY=not-needed

# ============================================
# COMMON SETTINGS (apply to all providers)
# ============================================
AIL_MODEL_TEMPERATURE=0.1
AIL_MODEL_MAX_TOKENS=4096
# AIL_MODEL_REASONING_EFFORT=medium  # For o1 models: low/medium/high

# Skills Repository
AIL_SKILLS_PATH=../growth-architect-store

# Memory
AIL_MEMORY_SQLITE_PATH=./data/agent_intelligence.db
AIL_MEMORY_CHROMA_PATH=./data/chroma
AIL_MEMORY_CHROMA_COLLECTION=agent_outputs
AIL_MEMORY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# MCP
AIL_MCP_ENABLED=true
AIL_MCP_SERVERS_DIR=./mcp/servers
AIL_MCP_CONFIG_FILE=./mcp/mcp_config.yaml
AIL_MCP_TIMEOUT_SECONDS=30

# Human Gate
AIL_HUMAN_GATE_ENABLED=true
AIL_HUMAN_GATE_API_PORT=8080
AIL_HUMAN_GATE_UI_PORT=8501
AIL_HUMAN_GATE_REQUIRE_APPROVAL_FOR=spend>10,external_send,data_export,contract_change,eval_score<8,blocker

# Observability
AIL_OBS_ENABLED=true
AIL_OBS_LOG_LEVEL=INFO
AIL_OBS_LOG_FILE=./logs/agent_intelligence.log
AIL_OBS_LANGFUSE_ENABLED=false
AIL_OBS_LANGFUSE_HOST=http://localhost:3000
AIL_OBS_LANGFUSE_PUBLIC_KEY=
AIL_OBS_LANGFUSE_SECRET_KEY=

# Runtime
AIL_DEBUG=false
AIL_MAX_CONCURRENT_ROLES=3
AIL_DEFAULT_BUDGET_USD=50.0